        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"meal_entries\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"eaten_at\" INTEGER NOT NULL, \"name\" TEXT NOT NULL, \"calories\" REAL NOT NULL, \"protein_g\" REAL NOT NULL, \"fat_g\" REAL NOT NULL, \"carbs_g\" REAL NOT NULL, \"meal_type\" INTEGER NULL);"
