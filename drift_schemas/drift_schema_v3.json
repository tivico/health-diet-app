          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"user_profiles\" (\"id\" INTEGER NOT NULL DEFAULT 1, \"sex\" INTEGER NOT NULL, \"age\" INTEGER NOT NULL, \"height_cm\" REAL NOT NULL, \"weight_kg\" REAL NOT NULL, \"activity\" INTEGER NOT NULL, \"goal\" INTEGER NOT NULL, \"body_fat_pct\" REAL NULL, \"target_weight_kg\" REAL NULL, PRIMARY KEY (\"id\"));"
