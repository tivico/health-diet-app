  "fixed_sql": [
    {
      "name": "user_profiles",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"user_profiles\" (\"id\" INTEGER NOT NULL DEFAULT 1, \"sex\" INTEGER NOT NULL, \"age\" INTEGER NOT NULL, \"height_cm\" REAL NOT NULL, \"weight_kg\" REAL NOT NULL, \"activity\" INTEGER NOT NULL, \"goal\" INTEGER NOT NULL, \"body_fat_pct\" REAL NULL, \"target_weight_kg\" REAL NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "meal_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"meal_entries\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"eaten_at\" INTEGER NOT NULL, \"name\" TEXT NOT NULL, \"calories\" REAL NOT NULL, \"protein_g\" REAL NOT NULL, \"fat_g\" REAL NOT NULL, \"carbs_g\" REAL NOT NULL, \"meal_type\" INTEGER NULL);"
        }
      ]
    },
    {
      "name": "weight_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"weight_entries\" (\"day\" INTEGER NOT NULL, \"weight_kg\" REAL NOT NULL, \"body_fat_pct\" REAL NULL, PRIMARY KEY (\"day\"));"
        }
      ]
    },
    {
      "name": "body_compositions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"body_compositions\" (\"day\" INTEGER NOT NULL, \"weight_kg\" REAL NOT NULL, \"body_fat_pct\" REAL NULL, \"fat_mass_kg\" REAL NULL, \"skeletal_muscle_kg\" REAL NULL, \"muscle_mass_kg\" REAL NULL, \"water_kg\" REAL NULL, \"fat_free_mass_kg\" REAL NULL, \"subcutaneous_fat_pct\" REAL NULL, \"visceral_fat_level\" REAL NULL, \"bmr_kcal\" REAL NULL, \"asmi\" REAL NULL, \"body_age\" REAL NULL, \"waist_cm\" REAL NULL, \"hip_cm\" REAL NULL, \"arm_cm\" REAL NULL, \"thigh_cm\" REAL NULL, \"neck_cm\" REAL NULL, \"chest_cm\" REAL NULL, \"source\" TEXT NULL, \"note\" TEXT NULL, PRIMARY KEY (\"day\"));"
        }
      ]
    }
